{
	"functions": {
		"api/*.js": {
			"memory": 512,
			"maxDuration": 30
		}
	},
	"routes": [
		{
			"src": "/api/proxy/(.*)",
			"dest": "/api/proxy?path=/api/$1"
		},
		{
			"src": "/api/env",
			"dest": "/api/env"
		},
		{
			"src": "/api/oauth-token-exchange",
			"dest": "/api/oauth-token-exchange"
		},
		{
			"src": "/api/oauth-userinfo",
			"dest": "/api/oauth-userinfo"
		}
	]
}
