{
	"functions": {
		"api/*.js": {
			"memory": 512,
			"maxDuration": 30
		}
	},
	"redirects": [
		{
			"source": "/about",
			"destination": "https://docs.eacof.org/about/",
			"permanent": true
		},
		{
			"source": "/contact",
			"destination": "https://docs.eacof.org/contact/",
			"permanent": true
		},
		{
			"source": "/privacy",
			"destination": "https://docs.eacof.org/privacy/",
			"permanent": true
		},
		{
			"source": "/terms",
			"destination": "https://docs.eacof.org/terms/",
			"permanent": true
		}
	],
	"routes": [
		{
			"src": "/api/proxy/(.*)",
			"dest": "/api/proxy?path=/api/$1"
		},
		{
			"src": "/api/env",
			"dest": "/api/env"
		},
		{
			"src": "/api/oauth-token-exchange",
			"dest": "/api/oauth-token-exchange"
		},
		{
			"src": "/api/oauth-userinfo",
			"dest": "/api/oauth-userinfo"
		}
	]
}
